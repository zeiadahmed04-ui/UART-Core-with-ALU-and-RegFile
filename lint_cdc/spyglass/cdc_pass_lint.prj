##Data Import Section

read_file -type sgdc SYS_TOP_.sgdc
read_file -type verilog ../rtl/ALU_top.v
read_file -type verilog ../rtl/ARITHMETIC_UNIT.v
read_file -type verilog ../rtl/ASYNC_FIFO_TOP.v
read_file -type verilog ../rtl/clk_divider.v
read_file -type verilog ../rtl/system_fsm.v
read_file -type verilog ../rtl/Top.v
read_file -type verilog ../rtl/UART_TX_Top.v
read_file -type verilog ../rtl/CMP_UNIT.v
read_file -type verilog ../rtl/Data_Sampling.v
read_file -type verilog ../rtl/data_sync.v
read_file -type verilog ../rtl/Decoder.v
read_file -type verilog ../rtl/deserializer.v
read_file -type verilog ../rtl/DF_SYNC.v
read_file -type verilog ../rtl/edge_bit_counter.v
read_file -type verilog ../rtl/FIFO_MEM_CNTRL.v
read_file -type verilog ../rtl/FIFO_RD.v
read_file -type verilog ../rtl/FIFO_WR.v
read_file -type verilog ../rtl/FSM.v
read_file -type verilog ../rtl/Fsm_tx.v
read_file -type verilog ../rtl/LOGIC_UNIT.v
read_file -type verilog ../rtl/Mux_4x1.v
read_file -type verilog ../rtl/out_mux.v
read_file -type verilog ../rtl/Parity_cal.v
read_file -type verilog ../rtl/parity_check.v
read_file -type verilog ../rtl/PULSE_GEN.v
read_file -type verilog ../rtl/regfile.v
read_file -type verilog ../rtl/rst_sych.v
read_file -type verilog ../rtl/Serilizer.v
read_file -type verilog ../rtl/SHIFT_UNIT.v
read_file -type verilog ../rtl/start_check.v
read_file -type verilog ../rtl/Stop_check.v
read_file -type verilog ../rtl/SYS_TOP.v
read_file -type gateslib ../std_cells/scmetro_tsmc_cl013g_rvt_tt_1p2v_25c.lib

##Common Options Section

set_option projectwdir .
set_option language_mode mixed
set_option designread_enable_synthesis yes
set_option designread_disable_flatten no
set_option active_methodology $SPYGLASS_HOME/GuideWare/latest/block/rtl_handoff


##Goal Setup Section

current_methodology $SPYGLASS_HOME/GuideWare/latest/block/rtl_handoff


current_goal cdc/cdc_setup_check -alltop
set_parameter enable_generated_clocks yes


current_goal cdc/clock_reset_integrity -alltop
set_parameter enable_generated_clocks yes


current_goal cdc/cdc_verify_struct -alltop
read_file -type awl ./spyglass-1/cdc/cdc_verify_struct/spyglass-1_waiver_file.awl
set_goal_option default_waiver_file ./spyglass-1/cdc/cdc_verify_struct/spyglass-1_waiver_file.awl
set_parameter enable_generated_clocks yes
set_parameter use_inferred_clocks yes


current_goal cdc/cdc_verify -alltop
read_file -type awl ./spyglass-1/cdc/cdc_verify/spyglass-1_waiver_file.awl
set_goal_option default_waiver_file ./spyglass-1/cdc/cdc_verify/spyglass-1_waiver_file.awl
set_parameter enable_generated_clocks yes


current_goal cdc/cdc_abstract -alltop
set_parameter enable_generated_clocks yes

